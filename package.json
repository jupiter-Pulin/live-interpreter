{
  "name": "live-interpreter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "macOS 本地实时会议同传原型：BlackHole 音频路由 + OpenAI gpt-realtime-translate 双向翻译管道",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
